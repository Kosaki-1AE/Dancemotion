import cv2
import socket
import pickle
import struct

# カメラ起動
cap = cv2.VideoCapture(0)

# ソケット作成
server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server_socket.bind(('0.0.0.0', 8485))  # 自分のIPでリッスン
server_socket.listen(5)
print("待機中...")

conn, addr = server_socket.accept()
print(f"{addr} と接続しました")

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    # エンコードして送信
    data = pickle.dumps(frame)
    msg = struct.pack("Q", len(data)) + data
    conn.sendall(msg)

cap.release()
conn.close()
server_socket.close()
